    "%lld / %lld done" : {
      "comment" : "A label showing the number of habits completed today out of the total number of habits. The first argument is the number of completed habits. The second argument is the total number of habits.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld / %2$lld done"
          }
        }
      }
    },
    "%lld %@" : {
      "comment" : "A label showing the number of times a habit was completed. The number is followed by a pluralized version of \"sessions\" (\"session\" or \"sessions\"). The argument is the string “habits_sessions_total”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld %2$@"
          }
        }
      }
    },
